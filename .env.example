# Cross-device sync (optional). Without these the app runs local-only.
# On Vercel: project → Storage → Create Database → Upstash Redis → connect.
# The integration adds these for you; either naming works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# or
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Override the site password without editing src/lib/auth.ts
DSA_BRAIN_PASSWORD=

# Redo nag mails (sent by /api/nag, triggered every 3h by .github/workflows/nag.yml)
GMAIL_USER=tncworks00@gmail.com
GMAIL_APP_PASSWORD=          # Google Account → Security → 2-Step Verification → App passwords
NAG_TO=ayyushkumar07@gmail.com
CRON_SECRET=                 # any long random string; same value goes in the GitHub repo secret CRON_SECRET
NAG_TZ=Asia/Kolkata          # which day it is, and quiet hours, are computed in this zone
NAG_QUIET_HOURS=0-7          # no mails between these hours; set to "off" to be nagged at 4am too

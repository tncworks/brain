# Cross-device sync (optional). Without these the app runs local-only.
# On Vercel: project → Storage → Create Database → Upstash Redis → connect.
# The integration adds these for you; either naming works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# or
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Override the site password without editing src/lib/auth.ts
DSA_BRAIN_PASSWORD=
